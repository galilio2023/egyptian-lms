# ==============================================================================
# ELITE ACADEMY LMS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless Postgres)
# ------------------------------------------------------------------------------
# Use the pooled connection string (with ?sslmode=require) for serverless functions
DATABASE_URL="postgresql://username:password@ep-cool-pool-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSIONS (Better Auth)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32+ byte string (e.g., openssl rand -base64 32)
BETTER_AUTH_SECRET="your-super-strong-secret-key-min-32-chars"
BETTER_AUTH_URL="https://elite-academy.edu.eg"
NEXT_PUBLIC_APP_URL="https://elite-academy.edu.eg"

# ------------------------------------------------------------------------------
# 3. VIDEO HOSTING & DRM STREAMING (Bunny.net Stream)
# ------------------------------------------------------------------------------
# Obtain from Bunny.net dashboard -> Stream -> Video Libraries -> API Key & Library ID
BUNNY_STREAM_API_KEY="your-bunny-stream-api-key"
BUNNY_STREAM_LIBRARY_ID="123456"
# Pull zone hostname for your stream library (e.g. vz-xxxxxx.b-cdn.net)
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxx.b-cdn.net"
# Security Token Authentication Key (for HMAC SHA-256 expiring DRM stream URLs)
BUNNY_TOKEN_SECURITY_KEY="your-bunny-token-security-key"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Paymob Egypt - Cards & Mobile Wallets)
# ------------------------------------------------------------------------------
PAYMOB_API_KEY="your-paymob-api-key"
PAYMOB_HMAC_SECRET="your-paymob-hmac-secret-for-webhook-verification"
PAYMOB_CARD_INTEGRATION_ID="123456"
PAYMOB_WALLET_INTEGRATION_ID="654321"

# ------------------------------------------------------------------------------
# 5. SUPPORT & MARKETING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="201020003000"
